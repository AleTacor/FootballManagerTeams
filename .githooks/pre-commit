#!/bin/sh
# Runs before every commit; the commit is aborted if any step fails.
# Enabled by `npm install` (the "prepare" script sets core.hooksPath to .githooks).
# Image tests skip cases whose screenshot isn't in src/test/fixtures/ (git-ignored).
set -e

echo "pre-commit: lint"
npm run --silent lint

echo "pre-commit: typecheck"
npm run --silent typecheck

echo "pre-commit: unit tests"
npm run --silent test

echo "pre-commit: screenshot tests"
npm run --silent test:images
