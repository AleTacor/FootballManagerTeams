{
  "name": "football-manager-teams",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:images": "vitest run --config vitest.images.config.ts",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks || true",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:images"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
